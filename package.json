{
  "name": "agent-forge-root",
  "version": "0.1.0.0",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@forge/web --filter=@forge/launchops",
    "build": "turbo build --filter=@forge/web --filter=@forge/launchops",
    "start": "turbo start --filter=@forge/web --filter=@forge/launchops",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "storybook": "pnpm --filter=@forge/web storybook",
    "storybook:build": "turbo storybook:build --filter=@forge/web",
    "analyze": "turbo analyze --filter=@forge/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "pnpm --filter=@forge/web test:e2e",
    "chromatic": "pnpm --filter=@forge/web chromatic",
    "test:scripts": "node --test 'scripts/__tests__/**/*.test.mjs'",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test:coverage && pnpm storybook:build && pnpm test:e2e"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/web/src/**/*.{ts,tsx}": [
      "pnpm --filter=@forge/web exec vitest related --run"
    ],
    "packages/ui/src/*.tsx": [
      "node scripts/check-story-coverage.mjs"
    ],
    "apps/web/src/features/**/components/*.tsx": [
      "node scripts/check-story-coverage.mjs"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "turbo": "^2.3.0",
    "typescript": "5.7.3"
  }
}
