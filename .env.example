# Forge API base URL. Public chat requires this to point at the backend API domain.
NEXT_PUBLIC_FORGE_API_BASE_URL=https://api.dev.mindrithm.ai
# =============================================================================
# Environment Variables — copy to .env.local and fill in values
# Source of truth: Vercel dashboard (pull with: pnpm dlx vercel env pull)
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development         # development | qa | staging | production

# Auth provider selection — determines which adapter is active at build/runtime
# Valid values: clerk | next-auth | okta   Default: clerk
NEXT_PUBLIC_AUTH_PROVIDER=clerk

# Brand / white-label selection — determines which brand config is active at build time
# Valid values: default | mindrithm | client-a | client-b   Default: mindrithm
NEXT_PUBLIC_BRAND=mindrithm

# Optional public demo chat link for the marketing landing page.
# When both are set, "See demo" links to /chat/:agentId?token=:shareToken.
NEXT_PUBLIC_DEMO_AGENT_ID=
NEXT_PUBLIC_DEMO_SHARE_TOKEN=

# Clerk Auth (required when NEXT_PUBLIC_AUTH_PROVIDER=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Auth Handler (required when NEXT_PUBLIC_AUTH_PROVIDER=auth-handler)
# Auth Handler is the OAuth 2.0 / OIDC server in forge-core
AUTH_HANDLER_ISSUER=http://localhost:3002/auth
AUTH_HANDLER_CLIENT_ID=agent-forge-web
AUTH_HANDLER_REDIRECT_URI=http://localhost:3000/callback
AUTH_HANDLER_SCOPE=openid profile email offline_access agents:read agents:write
AUTH_HANDLER_CONNECTION=clerk
AUTH_HANDLER_SESSION_SECRET=change-me-to-a-random-32-byte-hex-string
