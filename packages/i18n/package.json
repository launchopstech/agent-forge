{
  "name": "@forge/i18n",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./messages/*": "./messages/*",
    "./request": "./src/request.ts",
    "./routing": "./src/routing.ts",
    "./navigation": "./src/navigation.ts",
    "./actions": "./src/actions.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@forge/tsconfig": "workspace:*",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "happy-dom": "catalog:",
    "@types/node": "catalog:"
  }
}
